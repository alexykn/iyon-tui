{
  "name": "iyon-tui-workspace",
  "version": "0.1.0-s6.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "exports": {
    ".": "./packages/iyon-tui/src/index.ts",
    "./testing": "./packages/iyon-tui/src/testing/index.ts",
    "./native-stage": "./packages/iyon-tui/scripts/stage-native.ts"
  },
  "bin": {
    "iyon-tui-native-stage": "./packages/iyon-tui/scripts/stage-native.ts"
  },
  "workspaces": [
    "packages/iyon-tui",
    "packages/tui-consumer-fixture"
  ],
  "scripts": {
    "workspace:install": "bun install",
    "generate:tui-abi": "cargo run -q -p tui-abi-gen -- generate",
    "check:tui-abi": "cargo run -q -p tui-abi-gen -- check",
    "typecheck": "bunx tsc --noEmit",
    "lint:ts": "bunx --package @biomejs/biome@2.5.12 biome lint packages tools",
    "lint:ts:complexity": "bunx --package @biomejs/biome@2.5.12 biome lint --only=lint/complexity/noExcessiveCognitiveComplexity packages tools",
    "check:tui-declarations": "bun run tools/api-surface/check-declaration-closure.ts",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "sh tools/lint/clippy-gate.sh",
    "rust:test": "cargo test --workspace",
    "native:stage": "bun run packages/iyon-tui/scripts/stage-native.ts",
    "native:smoke": "bun run packages/iyon-tui/scripts/smoke-native.ts",
    "perf:content": "bun run packages/iyon-tui/bench/perf13_h_content.ts",
    "build:tui-native": "bun run packages/iyon-tui/scripts/stage-native.ts",
    "test": "bun test packages/iyon-tui/tests packages/tui-consumer-fixture/tests",
    "check:ownership": "bun run tools/ownership/check.ts"
  },
  "devDependencies": {
    "bun-types": "1.4.0"
  }
}
