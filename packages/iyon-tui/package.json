{
  "name": "@iyon/tui",
  "version": "0.1.0-s6.0",
  "license": "MIT",
  "type": "module",
  "description": "Generic terminal UI framework for Bun and TypeScript consumers",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./testing": "./src/testing/index.ts",
    "./native-stage": "./scripts/stage-native.ts"
  },
  "bin": {
    "iyon-tui-native-stage": "./scripts/stage-native.ts"
  },
  "scripts": {
    "native:stage": "bun run scripts/stage-native.ts",
    "native:smoke": "bun run scripts/smoke-native.ts",
    "perf:content": "bun run bench/react_content.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@types/react": "19.2.8",
    "@types/react-reconciler": "0.33.0",
    "bun-types": "1.4.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-reconciler": "0.33.0"
  }
}
